# Environment State (dev, test, prod)
ENV_STATE=dev

# Development Configuration
DEV_DB_URL=sqlite+aiosqlite:///dev.db
DEV_ADMIN_EMAIL=admin@payintable.com
DEV_ADMIN_PASSWORD=admin123
DEV_SECRET_KEY=dev-secret-key-change-in-production

# Seed Data
DEV_SEED_RESTAURANT_NAME=Demo Restaurant
DEV_SEED_RESTAURANT_SLUG=demo
DEV_SEED_LOCATION_NAME=Principal
DEV_SEED_LOCATION_SLUG=principal

# Frontend URL (for CORS)
DEV_FRONTEND_URL=http://localhost:3000

# Klap Payment Gateway (sandbox)
DEV_KLAP_API_KEY=your-klap-api-key
DEV_KLAP_API_URL=https://api-pasarela-sandbox.mcdesaqa.cl
DEV_KLAP_WEBHOOK_SECRET=your-webhook-secret

# AWS SES (optional for dev)
DEV_AWS_ACCESS_KEY_ID=
DEV_AWS_SECRET_ACCESS_KEY=
DEV_AWS_REGION=us-east-1
DEV_AWS_SES_SENDER=

# Production Configuration
PROD_DB_URL=postgresql+asyncpg://user:password@host:5432/payintable
PROD_ADMIN_EMAIL=admin@payintable.com
PROD_ADMIN_PASSWORD=secure-password-here
PROD_SECRET_KEY=production-secret-key-change-this

PROD_SEED_RESTAURANT_NAME=Your Restaurant
PROD_SEED_RESTAURANT_SLUG=your-restaurant
PROD_SEED_LOCATION_NAME=Principal
PROD_SEED_LOCATION_SLUG=principal

PROD_FRONTEND_URL=https://app.payintable.com

PROD_KLAP_API_KEY=your-production-klap-api-key
PROD_KLAP_API_URL=https://api-pasarela.klap.cl
PROD_KLAP_WEBHOOK_SECRET=your-production-webhook-secret

PROD_AWS_ACCESS_KEY_ID=your-aws-access-key
PROD_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
PROD_AWS_REGION=us-east-1
PROD_AWS_SES_SENDER=noreply@payintable.com